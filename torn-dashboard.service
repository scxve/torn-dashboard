[Unit]
Description=Torn City Raspberry Pi Dashboard
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/torn-dashboard
ExecStart=/home/pi/torn-dashboard/.venv/bin/python /home/pi/torn-dashboard/dashboard.py
Restart=on-failure
RestartSec=10
Environment=TERM=xterm-256color

[Install]
WantedBy=multi-user.target
